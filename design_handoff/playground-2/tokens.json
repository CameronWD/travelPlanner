    "fast": {
      "$type": "duration",
      "$value": "120ms"
    },
    "base": {
      "$type": "duration",
      "$value": "180ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "320ms"
    },
    "exit": {
      "$type": "duration",
      "$value": "200ms"
    },
    "stagger": {
      "$type": "duration",
      "$value": "40ms"
    }
  },
  "easing": {
    "pop": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.8,
        0.2,
        1
      ]
    },
    "bounce": {
      "$type": "cubicBezier",
      "$value": [
        0.34,
        1.56,
        0.64,
        1
      ]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    }
  },
