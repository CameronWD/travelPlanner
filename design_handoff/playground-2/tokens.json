  "shadow": {
    "hard-1": {
      "$type": "shadow",
      "$value": {
        "offsetX": "3px",
        "offsetY": "3px",
        "blur": "0px",
        "spread": "0px",
        "color": "{color.light.shadow-ink}"
      }
    },
    "hard-2": {
      "$type": "shadow",
      "$value": {
        "offsetX": "4px",
        "offsetY": "4px",
        "blur": "0px",
        "spread": "0px",
        "color": "{color.light.shadow-ink}"
      }
    },
    "hard-3": {
