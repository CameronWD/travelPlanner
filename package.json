    "feedback:accept": "tsx --conditions=react-server scripts/feedback-accept.ts",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:seed:demo": "tsx --conditions=react-server prisma/seed-demo.ts",
    "db:seed:real": "tsx --conditions=react-server prisma/seed-real.ts",
    "db:seed:real:dry": "tsx --conditions=react-server prisma/seed-real.ts --dry-run",
    "postinstall": "prisma generate"
