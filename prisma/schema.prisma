// Trip Planner — Prisma schema.
//
// All environments use Postgres: local dev runs a Postgres container via
// docker-compose; production uses Neon. To keep the schema portable:
//   * NO Prisma `enum`  — store enum-ish values as `String`, validate in app
//     code with the Zod unions in lib/enums.ts + lib/categories.ts.
//   * NO Prisma `Json`  — store JSON-ish data as a `String` of JSON.
// Money is `Int` minor units. Calendar dates are `String` "YYYY-MM-DD".
// Instants (transport dep/arr, timestamps) are `DateTime`. Lat/lng are `Float?`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7 no longer supports
  // `url` here). The PrismaClient is constructed with a driver adapter in
  // lib/db.ts.
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models — standard shapes required by
// @auth/prisma-adapter. Do not rename fields.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// Traveller-set display name (CONTEXT.md "Profile photo and display
  /// name"). NULL means the Traveller hasn't set one — lib/traveller.ts falls
  /// back to the sign-in provider's `name`, then the email local-part, then
  /// "Traveller". Never overwritten by signing in again; the adapter owns
  /// `name`/`image`, not this field.
  displayName String?

  /// Storage key of the Traveller's uploaded Profile photo (lib/storage.ts
  /// `generateKey({ user: id }, ...)`), served through
  /// `/api/avatars/:userId` so access is checked and the key itself never
  /// reaches the client. NULL means no uploaded photo — falls back to the
  /// sign-in provider's `image`.
  photoKey String?

  /// When `photoKey` was last set (upload or removal). Baked into the served
  /// avatar URL as a cache-buster (`?v=<ms>`) so replacing/removing a photo
  /// is visible immediately rather than waiting out a cached image.
  photoUpdatedAt DateTime?

  /// Focus point of the uploaded Profile photo, 0–1 across and down, chosen
  /// on Account (CONTEXT.md "Profile photo"). NULL = centre. Mirrors
  /// Trip.coverFocalX/Y; rendered via object-position, never by cropping.
  photoFocalX Float?
  photoFocalY Float?

  accounts Account[]
  sessions Session[]

  // Domain relations
  createdTrips     Trip[]            @relation("TripCreatedBy")
  forksCreated     Fork[]            @relation("ForkCreatedBy")
  memberships        TripMember[]
  notes              Note[]
  votes              Vote[]
  attachments        Attachment[]       @relation("AttachmentUploadedBy")
  assignedTasks      ChecklistItem[]    @relation("ChecklistAssignedTo")
  packingTemplates   PackingTemplate[]
  pushSubscriptions  PushSubscription[]
  journalEntries     JournalEntry[]
  activities         Activity[]
  globeMembership    GlobeMember?
  globesCreated      Globe[]       @relation("GlobeCreatedBy")
  markersCreated     Marker[]      @relation("MarkerCreatedBy")
  digestPreferences  DigestPreference[]
  digestDispatches   DigestDispatch[]
  travellerDetails   TravellerDetails?

  /// When this Traveller last dismissed the What's new card. NULL means they
  /// have never dismissed one, which the app reads as "caught up as of
  /// createdAt" rather than "has seen nothing" — see lib/release-notes.ts and
  /// ADR 0056.
  whatsNewSeenAt DateTime?

  /// When this Traveller closed the first-sign-in Welcome (spec 2026-10-01
  /// §G). NULL means they have not seen it, which is true of every account
  /// that existed before the column — they are meant to see it once too.
  welcomeSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// What a Traveller chooses to tell the people they travel with (CONTEXT.md
/// "Traveller details"): kept once, read on every Trip's Settings by fellow
/// Travellers. Nothing here is a passport or an insurance policy, by
/// decision. Only `mobile` can ever reach a Share link, and only by its dial.
model TravellerDetails {
  userId         String   @id
  mobile         String?
  emergencyName  String?
  emergencyPhone String?
  bankDetails    String?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

model Trip {
  id           String @id @default(cuid())
  name         String
  startDate    String? // "YYYY-MM-DD" — null while the trip is a date-less idea
  endDate      String? // "YYYY-MM-DD" — soft; auto-extends to cover scheduled stops
  hardEndDate  String? // "YYYY-MM-DD" — optional traveller-set ceiling; never auto-extends (see ADR 0013)
  roughMonth   String? // "YYYY-MM" — CONTEXT.md "Rough month". A wish, never a date: no date engine, Flags or Phase. Cleared whenever startDate is set.
  coverImageKey String? // storage key of the uploaded cover photo; null = use the route-render/monogram fallback
  coverFocalX  Float? // 0–1 across the cover photo: where its object-cover crop centres (spec E2); null = centre
  coverFocalY  Float? // 0–1 down the cover photo; null = centre
  coverAspect  Float? // width/height of the cover photo (spec F); null = not yet known. Portrait when < 0.9 — see lib/cover.ts isPortrait
  homeCurrency String // ISO 4217, e.g. "AUD"

  // URL slug from the name (ADR 0064). Nullable only so the previous build's
  // INSERTs keep working during the migrate-then-build window (DEPLOY.md §4b);
  // every write path in this build sets it. History: TripSlug.
  slug String? @unique

  // Recently deleted (ADR 0067): a deleted Trip is stamped, not destroyed,
  // and purged 30 days later. Null means live; every read that isn't the
  // Recently deleted list itself must exclude a stamped row.
  deletedAt DateTime?

  // Home base — the trip's origin (see ADR 0030). Not a Stop; never feeds the
  // date engine. Auto-geocoded on save like a Stop. roundTrip drives the
  // return-leg nudge/flag.
  homeName        String?
  homeLat         Float?
  homeLng         Float?
  homeCountryCode String?
  roundTrip       Boolean @default(true)

  // Route copy (CONTEXT.md): the Share link this Trip's rough Stops were
  // copied from. Plain string, no relation — attribution survives revocation.
  sourceShareLinkId String?

  // Chapters are opt-in per trip (spec 2026-08-24): off by default; the
  // migration backfills true for trips that already have chapters.
  chaptersEnabled Boolean @default(false)

  // Plan variants (Forks) are opt-in per trip (spec 2026-09-26 B3): off by
  // default; the migration backfills true for trips that already have a Fork.
  // Off leaves existing Forks dormant — they return when it is turned back on.
  forksEnabled Boolean @default(false)

  // Per-trip driving-estimate settings (used by drive-time hints + the
  // "long driving day" flag). Defaults suit mixed/winding roads.
  drivingWindingFactor Float @default(1.5)
  drivingAvgSpeedKph   Int   @default(80)

  createdById  String

  createdBy User @relation("TripCreatedBy", fields: [createdById], references: [id])

  members        TripMember[]
  invites        Invite[]
  stops          Stop[]
  transports     Transport[]
  accommodations Accommodation[]
  items          Item[]
  costs          Cost[]
  exchangeRates  ExchangeRate[]
  notes          Note[]
  votes          Vote[]
  checklistItems ChecklistItem[]
  attachments    Attachment[]
  reminders      Reminder[]
  shareLinks     ShareLink[]
  calendarFeed   CalendarFeed?
  journalEntries JournalEntry[]
  chapters       Chapter[]
  activities     Activity[]
  digestPreferences DigestPreference[]
  digestDispatches  DigestDispatch[]

  forks          Fork[]

  slugHistory TripSlug[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([deletedAt])
}

// Every slug a Trip has ever had (its current one included), so an old address
// keeps resolving and no other Trip can ever take it (ADR 0064). A deleted
// Trip's rows stay (tripId → NULL): its slugs remain reserved.
model TripSlug {
  slug      String   @id
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([tripId])
}

model Fork {
  id          String @id @default(cuid())
  tripId      String
  name        String
  sortOrder   Int    @default(0)
  createdById String

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation("ForkCreatedBy", fields: [createdById], references: [id])

  stops          Stop[]
  chapters       Chapter[]
  transports     Transport[]
  accommodations Accommodation[]
  items          Item[]
  costs          Cost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
}

model TripMember {
  id     String @id @default(cuid())
  tripId String
  userId String
  role   String // lib/enums.ts MEMBER_ROLES: "owner" | "member"

  /// The number this Traveller has on this Trip — an eSIM or local SIM
  /// (CONTEXT.md "Traveller details"). Theirs to set from the Trip's Settings.
  travelNumber String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadActivityAt DateTime?

  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([userId])
}

model Invite {
  id         String    @id @default(cuid())
  tripId     String
  email      String
  token      String    @unique
  role       String    @default("member")
  acceptedAt DateTime?
  /// Backfilled to NOW() + 30 days at the rollout-gate migration, never from
  /// createdAt — see that migration's header for why.
  expiresAt  DateTime?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tripId, email])
  @@index([tripId])
  @@index([email])
}

model Stop {
  id               String  @id @default(cuid())
  tripId           String
  forkId           String?
  name             String
  country          String?
  countryCode      String? // auto-derived ISO 3166-1 alpha-2 (lowercase, from Nominatim); null while un-derived
  lat              Float?
  lng              Float?
  timezone         String? // IANA — null while rough
  arriveDate       String? // "YYYY-MM-DD" — null while rough
  departDate       String? // "YYYY-MM-DD" — null while rough
  nights           Int?    // rough duration, used while rough
  sortOrder        Int
  pinned           Boolean @default(false) // dates fixed; ripple never moves it
  chapterId        String? // explicit chapter membership while rough
  chapterSortOrder Int     @default(0) // order within the chapter while rough
  notes            String?

  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fork           Fork?           @relation(fields: [forkId], references: [id], onDelete: Cascade)
  chapter        Chapter?        @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  accommodations Accommodation[]
  items          Item[]
  fromTransports   Transport[]     @relation("TransportFromStop")
  toTransports     Transport[]     @relation("TransportToStop")
  anchorTransports Transport[]     @relation("TransportAnchorStop")
  reminders        Reminder[]
  dayTitles        DayTitle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([forkId])
  @@index([chapterId])
}

// CONTEXT.md "Day title": an optional name for one day of a Stop's stay.
// Belongs to its owning Stop as that Stop's Nth day (dayIndex, 0-based
// offset from arriveDate) — no forkId/tripId column, since the Plan is
// whatever Plan the owning Stop is on (a Stop never changes Plan except by
// promote retagging, which carries its DayTitle rows for free). ADR 0049: a
// Changeover day carries at most one title, owned by whichever Stop set it.
model DayTitle {
  id       String @id @default(cuid())
  stopId   String
  dayIndex Int // 0-based offset from the owning Stop's arriveDate
  title    String

  stop Stop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stopId, dayIndex])
}

model Chapter {
  id        String  @id @default(cuid())
  tripId    String
  forkId    String?
  name      String
  colour    String  // lib/chapter-colours.ts CHAPTER_COLOUR_VALUES
  startDate String? // "YYYY-MM-DD" — null while rough
  endDate   String? // "YYYY-MM-DD" — null while rough
  sortOrder Int     @default(0)

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fork  Fork?  @relation(fields: [forkId], references: [id], onDelete: Cascade)
  stops Stop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([forkId])
}

model Transport {
  id         String    @id @default(cuid())
  tripId     String
  forkId     String?
  fromStopId String?
  toStopId   String?
  mode       String // lib/enums.ts TRANSPORT_MODES
  depPlace   String?
  depAt      DateTime?
  arrPlace   String?
  arrAt      DateTime?
  depLat     Float?
  depLng     Float?
  arrLat     Float?
  arrLng     Float?
  depIsHome  Boolean @default(false) // departs the trip's Home base (see ADR 0030)
  arrIsHome  Boolean @default(false) // arrives the trip's Home base
  reference  String?
  notes      String?
  sortOrder  Int       @default(0)

  anchorStopId String?

  trip       Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fork       Fork? @relation(fields: [forkId], references: [id], onDelete: Cascade)
  fromStop   Stop? @relation("TransportFromStop", fields: [fromStopId], references: [id], onDelete: SetNull)
  toStop     Stop? @relation("TransportToStop", fields: [toStopId], references: [id], onDelete: SetNull)
  anchorStop Stop? @relation("TransportAnchorStop", fields: [anchorStopId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([forkId])
  @@index([anchorStopId])
}

model Accommodation {
  id           String  @id @default(cuid())
  tripId       String
  forkId       String?
  stopId       String
  name         String
  address      String?
  checkIn      String // "YYYY-MM-DD"
  checkOut     String // "YYYY-MM-DD"
  checkInTime  String? // "HH:mm" in the stop's local timezone — optional (CONTEXT.md Accommodation)
  checkOutTime String? // "HH:mm"
  confirmation String?
  notes        String?
  lat          Float?
  lng          Float?

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fork Fork? @relation(fields: [forkId], references: [id], onDelete: Cascade)
  stop Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([forkId])
  @@index([stopId])
}

model Item {
  id        String  @id @default(cuid())
  tripId    String
  forkId    String?
  stopId    String?
  title     String
  category  String // lib/categories.ts CATEGORY_VALUES
  date      String? // "YYYY-MM-DD" — null = unscheduled (wishlist)
  startTime String? // "HH:mm" in the stop's local timezone
  endTime   String? // "HH:mm"
  lat       Float?
  lng       Float?
  countryCode String? // ISO 3166-1 alpha-2, lowercase, derived by geocoding — same as Stop/Marker
  address   String?
  link      String?
  booking   String?
  notes     String?
  sortOrder      Int     @default(0)
  sourceItemId   String?
  sourceMarkerId String?
  hiddenFromShares Boolean @default(false) // CONTEXT.md "Share link" — never leaves via a share link (ADR 0051 floor); still fully visible to every Traveller

  /// CONTEXT.md "Item photo": the one Attachment (targetType ITEM, targetId
  /// this Item's id) singled out as this Item's visual reference. Deliberately
  /// NO Prisma relation/FK — resolved leniently in app code
  /// (lib/item-photo.ts `itemPhotoUrl`): a stale id (its Attachment row
  /// deleted without going through removeItemPhoto/setItemPhoto) just misses
  /// the lookup and renders no photo, rather than a hard foreign-key error.
  /// Scheduling a Wishlist idea (ADR 0019 copy-in) and forking both copy the
  /// storage object and mint a NEW Attachment for the placed/forked Item —
  /// this column is never shared between two Items.
  photoAttachmentId String?

  trip         Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fork         Fork?   @relation(fields: [forkId], references: [id], onDelete: Cascade)
  stop         Stop?   @relation(fields: [stopId], references: [id], onDelete: SetNull)
  sourceItem   Item?   @relation("ItemPlacedFrom", fields: [sourceItemId], references: [id], onDelete: SetNull)
  placements   Item[]  @relation("ItemPlacedFrom")
  sourceMarker Marker? @relation("ItemFromMarker", fields: [sourceMarkerId], references: [id], onDelete: SetNull)
  votes        Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([forkId])
  @@index([stopId])
  @@index([sourceItemId])
  @@index([sourceMarkerId])
}

model Cost {
  id             String    @id @default(cuid())
  tripId         String
  forkId         String?
  costMinor      Int // minor units, always present
  paidMinor      Int? // minor units — what was actually charged; null until paid
  currency       String // ISO 4217
  rateToHome     Float? // snapshotted FX rate at entry, or null if same currency
  paidAt         DateTime?
  dueDate        String? // "YYYY-MM-DD" — when an unpaid cost's money leaves the account (CONTEXT.md "Due date")
  settlement     String    @default("BEFORE") // lib/enums.ts COST_SETTLEMENTS — BEFORE | ON_TRIP; which side of departure it's paid (CONTEXT.md "Settlement")
  ownerType      String // lib/enums.ts COST_OWNER_TYPES
  ownerId        String? // null when ownerType == OTHER
  label          String? // names an OTHER cost (e.g. "Travel insurance")
  category       String?

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fork Fork? @relation(fields: [forkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([forkId])
  @@index([ownerType, ownerId])
  @@index([dueDate])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  tripId    String
  base      String // ISO 4217
  quote     String // ISO 4217
  rate      Float
  fetchedAt DateTime
  manual    Boolean  @default(false)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, base, quote])
  @@index([tripId])
}

model Note {
  id         String @id @default(cuid())
  tripId     String
  authorId   String
  targetType String // lib/enums.ts TARGET_TYPES
  targetId   String
  body       String

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([targetType, targetId])
}

model Vote {
  id     String @id @default(cuid())
  tripId String
  itemId String
  userId String
  level  String // lib/enums.ts VOTE_LEVELS

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tripId, itemId, userId])
  @@index([itemId])
}

model ChecklistItem {
  id           String  @id @default(cuid())
  tripId       String
  kind         String // lib/enums.ts CHECKLIST_KINDS
  text         String
  done         Boolean @default(false)
  dueDate      String? // "YYYY-MM-DD"
  sortOrder    Int     @default(0)
  assignedToId String?

  trip       Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("ChecklistAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
}

model Attachment {
  id           String  @id @default(cuid())
  tripId       String?
  globeId      String?
  targetType   String // lib/enums.ts TARGET_TYPES
  targetId     String?
  filename     String
  /// A name the Traveller gave the file (CONTEXT.md "Attachment"); shown in
  /// place of the filename wherever the file is listed. Null = none.
  title        String?
  mime         String
  size         Int
  url          String // public serve path: /api/attachments/<id>
  storageKey   String? // opaque key used by the Storage abstraction
  uploadedById String

  trip       Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)
  globe      Globe? @relation(fields: [globeId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([globeId])
  @@index([targetType, targetId])
}

model PackingTemplate {
  id        String @id @default(cuid())
  ownerId   String
  name      String
  itemsJson String // JSON-encoded array of template items (schema avoids Prisma Json by design)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// A Traveller's dated note (CONTEXT.md "Reminder"). Carries a date and never
/// a time: TEEPEE dispatches at a few fixed hours, so a promised 14:30 would
/// be a lie — an Alarm is what fires precisely. Surfaces in that day's Digest
/// and on Home. See ADR 0047.
///
/// `stopId` (Task 7): a Reminder may be about a Stop. NULL means "about the
/// Trip as a whole" — every Reminder before this column existed reads that
/// way. Deleting the Stop does not delete the Reminder (onDelete: SetNull):
/// the note the Traveller wrote still matters even once its Stop is gone.
model Reminder {
  id     String  @id @default(cuid())
  tripId String
  stopId String?
  title  String
  date   String // "YYYY-MM-DD"

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop Stop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([date])
  @@index([stopId])
}

model ShareLink {
  id        String   @id @default(cuid())
  tripId    String
  token     String   @unique
  label     String
  createdAt DateTime @default(now())

  // Scope dials — what this audience sees (ADR 0051). Money, notes,
  // confirmations and booking refs are never shared regardless of dials.
  includeAccommodation Boolean @default(true)
  includeTransport     Boolean @default(true)
  includeDailyPlans    Boolean @default(true)

  /// Fourth dial (ADR 0051 amendment, 2026-09-27): the "How it's going"
  /// Journal section. Off by default and off on every existing link —
  /// unlike the three dials above, a family/friends link does not get the
  /// Journal until someone deliberately turns it on.
  includeJournal Boolean @default(false)

  /// Fifth dial (ADR 0051 amendment, 2026-09-30): "Show who's going" — the
  /// Travellers' display names and profile photos on the hero. Off by default
  /// and off on every existing link. Email is never selected on any link.
  showTravellers Boolean @default(false)

  /// Sixth dial (spec 2026-10-02 §E): each Traveller's home mobile and travel
  /// number under their name on the hero. Off by default, off on every
  /// existing link, and only honoured while showTravellers is on. The
  /// emergency contact, bank details and sign-in email are never selected
  /// by any link.
  includeContacts Boolean @default(false)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model CalendarFeed {
  id        String   @id @default(cuid())
  tripId    String   @unique
  token     String   @unique
  createdAt DateTime @default(now())

  // Which event types this feed publishes. All default true so existing
  // feeds keep publishing everything until a member narrows them.
  includeTransport     Boolean @default(true)
  includeAccommodation Boolean @default(true)
  includeActivities    Boolean @default(true)

  // Alarms the external calendar app fires (CONTEXT.md "Alarm"). Default on so
  // an existing feed starts alerting as soon as its subscriber allows it.
  alarmTransport Boolean @default(true)
  alarmCheckOut  Boolean @default(true)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id       String  @id @default(cuid())
  userId   String
  endpoint String  @unique
  p256dh   String
  auth     String
  timezone String? // IANA zone, re-reported by the Device on every visit (ADR 0047)
  label    String? // Coarse Device name from lib/device-label.ts; set once (ADR 0048)

  createdAt DateTime @default(now())
  // Stamped by this Device's own browser on visit. A Device that loses
  // permission stops reporting, which is the ONLY way TEEPEE can notice —
  // the push service reports success either way (ADR 0048).
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JournalEntry {
  id       String @id @default(cuid())
  tripId   String
  date     String // "YYYY-MM-DD"
  body     String
  authorId String

  /// Per-entry "Keep off Share links" switch (spec L / ADR 0051 amendment):
  /// off by default, so a Share link with its Journal dial on still shows
  /// every existing entry exactly as it does today.
  hiddenFromShares Boolean @default(false)

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-Traveller entries per day, not one shared entry (rollout-gate
  // migration) — each Traveller keeps their own Journal entry for a date
  // rather than overwriting the other's.
  @@unique([tripId, date, authorId])
  @@index([tripId])
}

model Activity {
  id          String   @id @default(cuid())
  tripId      String
  actorId     String
  verb        String // CREATED | UPDATED | DELETED | NOTED
  entityType  String // STOP | ITEM | TRANSPORT | ACCOMMODATION | CHAPTER | COST | NOTE
  entityId    String?
  entityLabel String // snapshot so deleted entities still render
  changes     Json? // [{ field, label, from, to }] for UPDATED; { excerpt } for NOTED
  createdAt   DateTime @default(now())

  trip  Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}

// ---------------------------------------------------------------------------
// The Globe — a single shared, cross-trip collection of places to visit.
// Account-level aggregate, decoupled from Trip (see ADR 0023). Rendered as a
// flat Leaflet map (see ADR 0024).
// ---------------------------------------------------------------------------

model Globe {
  id          String @id @default(cuid())
  createdById String

  createdBy   User          @relation("GlobeCreatedBy", fields: [createdById], references: [id])
  members     GlobeMember[]
  markers     Marker[]
  invites     GlobeInvite[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model GlobeMember {
  id      String @id @default(cuid())
  globeId String
  userId  String
  role    String // lib/enums.ts MEMBER_ROLES: "owner" | "member"

  globe Globe @relation(fields: [globeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // A user belongs to at most one Globe (ADR 0023) — enforced globally, not
  // just per-globe, so a userId appears in exactly one GlobeMember row.
  @@unique([userId])
  @@index([globeId])
}

model GlobeInvite {
  id         String    @id @default(cuid())
  globeId    String
  email      String
  token      String    @unique
  role       String    @default("member")
  acceptedAt DateTime?
  /// Backfilled to NOW() + 30 days at the rollout-gate migration, never from
  /// createdAt — see that migration's header for why.
  expiresAt  DateTime?

  globe Globe @relation(fields: [globeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([globeId, email])
  @@index([globeId])
  @@index([email])
}

model Marker {
  id          String  @id @default(cuid())
  globeId     String
  title       String
  category    String // lib/categories.ts CATEGORY_VALUES
  note        String?
  link        String?
  timing      String? // rough free-text "when" (e.g. "late Sept") — never a scheduled date
  lat         Float?
  lng         Float?
  city        String? // auto-derived town/city
  country     String? // auto-derived country name
  countryCode String? // auto-derived ISO 3166-1 alpha-2 (lowercase, from Nominatim)
  createdById String

  globe          Globe  @relation(fields: [globeId], references: [id], onDelete: Cascade)
  createdBy      User   @relation("MarkerCreatedBy", fields: [createdById], references: [id])
  wishlistCopies Item[] @relation("ItemFromMarker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([globeId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Feedback about the app itself — inert product data, read by no feature.
// See ADR 0040 (capture + export) and ADR 0041 (offline queue).
// ---------------------------------------------------------------------------

model FeedbackNote {
  id        String @id @default(cuid())
  /// Client-generated, reused on every retry — the duplicate guard for the
  /// offline flush (ADR 0041).
  clientKey String @unique
  body      String

  // Circumstances the app records for itself, so a note is understandable
  // without asking the author where they were.
  route     String
  pageLabel String
  /// Snapshots, deliberately NOT foreign keys: feedback outlives the Trip it
  /// was written about (ADR 0040).
  tripId    String?
  tripName  String?
  viewport  String?
  userAgent String?

  /// Which deployment the note was written on — "main", a preview branch
  /// ("beta"), or "local". Set by the server (lib/feedback-site.ts), never by
  /// the client. NULL = written before sites were recorded; counts as main
  /// (ADR 0040, amended 2026-09-26).
  site      String?

  /// Snapshots, deliberately NOT foreign keys: feedback outlives both the Trip
  /// it was written about and the Traveller who wrote it (ADR 0040, amended
  /// 2026-09-21). A deleted User cannot sign in, so their id can never match a
  /// viewer's — an orphaned note is admin-only without a rule for it.
  authorId   String
  authorName String?

  /// NEEDS_REVIEW | OPEN | DONE | WONTFIX (lib/enums.ts FEEDBACK_STATUSES). The
  /// server writes OPEN for an Admin author and NEEDS_REVIEW for anyone else;
  /// the default only covers rows written before vetting (ADR 0040, amended
  /// 2026-09-29). A free string, so the fourth value needed no migration.
  status     String    @default("OPEN")
  resolution String?
  resolvedAt DateTime?

  /// When the author wrote it (client clock) — may precede createdAt.
  authoredAt DateTime
  /// When it reached the server.
  createdAt  DateTime @default(now())

  @@index([status, authoredAt])
  @@index([authorId])
}

/// One Traveller's Digest opt-in for one Trip (ADR 0047). Absent row means
/// "never chosen" and is treated as enabled — subscribing a device is itself
/// the opt-in, so an existing subscriber is not silently muted by a missing row.
model DigestPreference {
  id      String  @id @default(cuid())
  userId  String
  tripId  String
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tripId])
  @@index([tripId])
}

/// Idempotency ledger: one row per Digest actually claimed for a person, Trip,
/// local date and slot. Claimed BEFORE sending, so a re-run (or two overlapping
/// cron runs) can never double-send. Replaces the old per-cost COST_DUE marker.
model DigestDispatch {
  id        String @id @default(cuid())
  userId    String
  tripId    String
  localDate String // "YYYY-MM-DD" in the subscriber's own timezone
  slot      String // "MORNING" | "EVENING"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, tripId, localDate, slot])
  @@index([tripId])
}

/// A single row, stamped on every authorized cron hit whether or not anything
/// was sent. DigestDispatch rows only exist when a Digest went out, so they
/// cannot distinguish a quiet week from a dispatcher that stopped running.
model CronHeartbeat {
  id            String    @id @default("digest")
  lastRunAt     DateTime
  /// Stamped only after a scan completes. `lastRunAt` proves the route ran and
  /// was authorized; this proves the dispatch loop got to the end (CD-06).
  /// Nullable so the migration is additive on the write path too — the
  /// still-running old build never writes it (docs/DEPLOY.md §4b).
  lastSuccessAt DateTime?
}

// ---------------------------------------------------------------------------
// Rollout gate — who is allowed to sign in, and the operator-facing sinks
// that keep the gate itself observable and honest.
// ---------------------------------------------------------------------------

/// An email permitted to sign in. Read together with the ALLOWED_EMAILS env
/// var by lib/allowlist.ts — the env var is bootstrap and break-glass, this
/// table is everyone admitted through the product (ADR 0057).
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  addedById String?
  note      String?
  createdAt DateTime @default(now())
}

/// A person without an account asking for one. Distinct from Invite, which is
/// Trip-scoped and owner-only (ADRs 0017, 0052). Written by the signIn
/// callback from Google's verified profile at the moment of rejection.
model AccessRequest {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  status        String    @default("pending") // "pending" | "dismissed"
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  lastAttemptAt DateTime  @default(now())
  attempts      Int       @default(1)

  @@index([status])
}

/// A captured application failure. Deduped by `signature` so a loop logs one
/// row with a count, not ten thousand rows (ADR 0059).
model ErrorReport {
  id        String   @id @default(cuid())
  signature String   @unique
  message   String
  stack     String?
  route     String?
  source    String   @default("server") // "server" | "client"
  userId    String?
  /// React's own error digest (Error & { digest?: string }), present on
  /// server-component render errors — the only handle that still
  /// correlates a client report back to a specific server-side failure once
  /// production React has replaced its message with a fixed generic string.
  digest    String?
  count     Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
}

/// A storage blob whose owning row is gone but which is retained so a database
/// restore can still find its file. Swept after 35 days — deliberately longer
/// than db-backup.yml's 30-day dump retention (ARCH-DAT-3).
model DeletedBlob {
  id         String   @id @default(cuid())
  storageKey String   @unique
  deletedAt  DateTime @default(now())

  @@index([deletedAt])
}

/// A one-row-per-key ledger for operator pushes that must not repeat more
/// than once a day (spec 2026-10-02 §B). Key "storage-ceiling" is the first
/// user; notifyStorageCeiling (lib/storage-ceiling-notice.ts) reads and
/// writes it.
model OperatorNotice {
  key        String   @id
  lastSentAt DateTime
}
